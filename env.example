# Legacy environment template for Railway/manual installs.
# Recommended VPS/Docker Compose deployment uses config/config.json instead;
# Compose supplies its own MongoDB URI, data path, and health port.
# ============================================================================
#  Telegram API — https://my.telegram.org/apps
# ============================================================================
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Bot token from @BotFather
BOT_TOKEN=your_bot_token_here
BOT_SESSION_NAME=bot2

# ============================================================================
#  Ownership  — set AT LEAST ONE of the three (any one is enough)
# ============================================================================
# The bot resolves the owner in this order: ADMIN_ID -> OWNER_ID -> first ADMIN_IDS.
# Railway/Render deployments usually set OWNER_ID + ADMIN_IDS and leave
# ADMIN_ID unset — that is perfectly fine.
#
# ADMIN_ID — main admin (old name, still fully supported)
ADMIN_ID=
# OWNER_ID — the owner: sees everything, incl. the owner-only Send PV button
OWNER_ID=
# Extra admins (comma separated) that may also use the admin panel
ADMIN_IDS=

# ============================================================================
#  Database (strongly recommended)
# ============================================================================
# When MONGODB_URI is set, ALL state lives in MongoDB: signed-in accounts (with
# full session strings), users, wallets, orders, payments, channels, settings
# and the entity access-hash cache. A crash, restart or rebuilt container then
# cannot lose anything.
#
#   Local MongoDB:   mongodb://127.0.0.1:27017
#   MongoDB Atlas:   mongodb+srv://user:pass@cluster.mongodb.net
#   Railway plugin:  leave this empty — the plugin sets MONGO_URL (and
#                    MONGOHOST/MONGOUSER/MONGOPASSWORD) and the bot reads them
#
# Aliases accepted automatically: MONGO_URI, MONGODB_URL, MONGO_URL,
# or the parts MONGOHOST + MONGOPORT + MONGOUSER + MONGOPASSWORD.
#
# Leave everything empty to fall back to the local JSON store (DATA_DIR) —
# still crash-safe, but single machine only.
MONGODB_URI=
MONGODB_DB=telegram_panel

# auto   -> MongoDB when MONGODB_URI is set and reachable, else JSON fallback
# mongo  -> insist on MongoDB (fail fast instead of silently degrading)
# json   -> always use the local JSON store
# memory -> in-process only (tests / dry runs)
STORAGE_BACKEND=auto

# Where the JSON fallback store lives. Leave empty to auto-detect: an explicit
# DATA_DIR, else /data when it is writable (Railway Volume), else ./data.
DATA_DIR=

# ----------------------------------------------------------------------------
# Health/admin endpoint (Railway/Render inject PORT; Compose sets 8070 itself)
# ----------------------------------------------------------------------------
# The same server provides /health and /admin. Set a unique password of at
# least 16 characters and a random secret of at least 32 characters.
# On Docker Compose, use config/config.json instead of this legacy template.
ADMIN_PANEL_PASSWORD=
ADMIN_PANEL_SECRET=
# Set to 0/false to serve health endpoints only.
WEB_ADMIN=1
# Leave blank on platforms that inject PORT. Manual VPS installs may use 8070.
HEALTH_PORT=
# PORT is set by the platform; do not set it yourself there.
# PORT=
HEALTH_HOST=0.0.0.0

# ============================================================================
#  Panel look & contact
# ============================================================================
# Support account shown in the user panel's 🆘 Support screen
SUPPORT_USERNAME=
# Currency symbol used everywhere in the panel (prices are set from the panel)
CURRENCY=₹

# ============================================================================
#  Payments (manual UPI by default — edit from the admin panel too)
# ============================================================================
PAYMENT_UPI_ID=
PAYMENT_UPI_NAME=

# ============================================================================
#  Monitoring / forwarding (optional)
# ============================================================================
CHANNEL_ID=your_channel_id_or_username
CLIENTS_JSON_PATH=clients.json
RATE_LIMIT_SLEEP=60
GROUPS_BATCH_SIZE=10
GROUPS_UPDATE_SLEEP=60

# Ports (optional)
HTTP_PORT=80
HTTPS_PORT=443
TELEGRAM_PORT=443

# Bot that checks report status (optional)
REPORT_CHECK_BOT=

# ============================================================================
#  Notes
# ============================================================================
# * Values may be quoted or unquoted, with or without spaces — quotes and
#   stray line breaks are stripped automatically (Railway's raw editor stores
#   them literally).
# * Only API_ID, API_HASH, BOT_TOKEN and one owner id are required to start.
# * MONGODB_URI / MONGO_URL is strongly recommended so nothing is lost on a
#   restart or redeploy.
